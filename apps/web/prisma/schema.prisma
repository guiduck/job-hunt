generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketScope {
  BR
  INTERNATIONAL
}

enum CampaignStatus {
  draft
  ready
  collecting
  paused
  completed
  failed
  archived
}

enum ProspectingJobStatus {
  pending
  running
  completed
  completed_no_results
  failed
  cancelled
}

enum ProspectingJobStep {
  queued
  discovering_businesses
  normalizing_results
  deduplicating
  fetching_websites
  analyzing_websites
  scoring_leads
  saving_leads
  done
}

enum WebsiteStatus {
  no_site
  social_only
  linktree
  aggregator
  broken
  weak_site
  usable_site
  uncertain
}

enum LeadTemperature {
  cold
  warm
  hot
}

enum CommercialStatus {
  new
  contacted
  interested
  proposal_requested
  proposal_sent
  won
  lost
  ignored
}

enum TemplateStage {
  first_contact
  follow_up
}

enum GeneratedTextKind {
  lovable_prompt
  commercial_message
}

enum NicheLifecycleStatus {
  approved
  disabled
  merged
}

enum NicheCandidateStatus {
  proposed
  approved
  rejected
  deferred
  already_covered
}

enum NicheAuditSeverity {
  info
  warning
  blocking
}

enum NicheAuditStatus {
  passed
  warnings
  failed
}

enum OutreachChannel {
  email
  whatsapp
}

enum BulkOutreachBatchStatus {
  draft
  queued
  running
  completed
  failed
  approved
  partially_sent
  sent
}

enum BulkOutreachItemStatus {
  queued
  generating
  generated
  generation_failed
  missing_contact
  invalid_contact
  duplicate_blocked
  skipped
  approved
  sending
  sent
  failed_send
}

enum OutreachEventType {
  generated
  generation_failed
  item_updated
  skipped
  unskipped
  approved
  queued_send
  sent
  failed_send
  blocked_missing_contact
  blocked_invalid_contact
  blocked_duplicate
  blocked_channel_not_ready
  blocked_rate_limit
}

enum ChannelReadinessStatus {
  ready
  missing_config
  missing_credentials
  not_approved
  missing_template
  missing_opt_in
  rate_limited
  provider_error
  disabled
}

model FreelanceNiche {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  market               String                @default("both")
  conversionHint       Decimal?              @map("conversion_hint") @db.Decimal(5, 2)
  defaultTerms         Json                  @default("[]") @map("default_query_terms")
  displayName          String?               @map("display_name")
  sourceName           String?               @map("source_name")
  sourcePath           String?               @map("source_path")
  sourceNote           String?               @map("source_note")
  conversionHintSource String?               @map("conversion_hint_source")
  aliases              Json                  @default("[]")
  queryTerms           Json                  @default("[]") @map("query_terms")
  marketApplicability  String                @default("both") @map("market_applicability")
  lifecycleStatus      NicheLifecycleStatus  @default(approved) @map("lifecycle_status")
  mergedIntoNicheId    String?               @map("merged_into_niche_id")
  lastAuditedAt        DateTime?             @map("last_audited_at")
  enabled              Boolean               @default(true)
  sortOrder            Int                   @default(0) @map("sort_order")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  campaigns            FreelanceCampaign[]
  leads                FreelanceLead[]
  mergedIntoNiche      FreelanceNiche?       @relation("MergedNiches", fields: [mergedIntoNicheId], references: [id])
  mergedNiches         FreelanceNiche[]      @relation("MergedNiches")
  matchedCandidates    NicheCandidate[]      @relation("CandidateMatchedNiche")
  auditFindings        NicheAuditFinding[]

  @@index([enabled, lifecycleStatus])
  @@index([marketApplicability])
  @@map("freelance_niches")
}

model NicheCandidate {
  id                     String               @id @default(cuid())
  proposedName           String               @map("proposed_name")
  normalizedName         String               @map("normalized_name")
  proposedSlug           String               @map("proposed_slug")
  marketApplicability    String               @default("both") @map("market_applicability")
  proposedConversionHint Decimal?             @map("proposed_conversion_hint") @db.Decimal(5, 2)
  proposedQueryTerms     Json                 @default("[]") @map("proposed_query_terms")
  sourcePath             String               @map("source_path")
  sourceExcerpt          String?              @map("source_excerpt")
  sourceNote             String?              @map("source_note")
  status                 NicheCandidateStatus @default(proposed)
  matchedNicheId         String?              @map("matched_niche_id")
  decisionReason         String?              @map("decision_reason")
  reviewedAt             DateTime?            @map("reviewed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  matchedNiche           FreelanceNiche?      @relation("CandidateMatchedNiche", fields: [matchedNicheId], references: [id])
  auditFindings          NicheAuditFinding[]

  @@index([status, marketApplicability])
  @@index([proposedSlug])
  @@map("niche_candidates")
}

model NicheAuditRun {
  id                      String              @id @default(cuid())
  status                  NicheAuditStatus
  baselineCount           Int                 @map("baseline_count")
  approvedCount           Int                 @map("approved_count")
  candidateCount          Int                 @default(0) @map("candidate_count")
  missingCount            Int                 @default(0) @map("missing_count")
  extraCount              Int                 @default(0) @map("extra_count")
  duplicateCount          Int                 @default(0) @map("duplicate_count")
  encodingIssueCount      Int                 @default(0) @map("encoding_issue_count")
  conversionMismatchCount Int                 @default(0) @map("conversion_mismatch_count")
  sourceSummary           Json                @default("{}") @map("source_summary")
  createdAt               DateTime            @default(now()) @map("created_at")
  findings                NicheAuditFinding[]

  @@index([status, createdAt])
  @@map("niche_audit_runs")
}

model NicheAuditFinding {
  id             String             @id @default(cuid())
  runId          String             @map("run_id")
  severity       NicheAuditSeverity
  findingType    String             @map("finding_type")
  nicheId        String?            @map("niche_id")
  candidateId    String?            @map("candidate_id")
  referenceName  String?            @map("reference_name")
  currentName    String?            @map("current_name")
  expectedValue  String?            @map("expected_value")
  currentValue   String?            @map("current_value")
  message        String
  createdAt      DateTime           @default(now()) @map("created_at")
  run            NicheAuditRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  niche          FreelanceNiche?    @relation(fields: [nicheId], references: [id])
  candidate      NicheCandidate?    @relation(fields: [candidateId], references: [id])

  @@index([runId, severity])
  @@index([findingType])
  @@map("niche_audit_findings")
}

model FreelanceCampaign {
  id                     String             @id @default(cuid())
  userId                 String             @map("user_id")
  name                   String
  marketScope            MarketScope        @map("market_scope")
  country                String
  region                 String?
  state                  String?
  city                   String
  nicheId                String             @map("niche_id")
  nicheNameSnapshot      String             @map("niche_name_snapshot")
  conversionHintSnapshot Decimal?           @map("conversion_hint_snapshot") @db.Decimal(5, 2)
  status                 CampaignStatus     @default(draft)
  searchSettings         Json               @default("{}") @map("search_settings")
  leadCount              Int                @default(0) @map("lead_count")
  hotLeadCount           Int                @default(0) @map("hot_lead_count")
  contactedCount         Int                @default(0) @map("contacted_count")
  notes                  String?
  lastRunAt              DateTime?          @map("last_run_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  archivedAt             DateTime?          @map("archived_at")
  niche                  FreelanceNiche     @relation(fields: [nicheId], references: [id])
  jobs                   ProspectingJob[]
  leads                  FreelanceLead[]
  bulkOutreachBatches    BulkOutreachBatch[]
  bulkOutreachItems      BulkOutreachItem[]
  outreachEvents         OutreachEvent[]

  @@index([userId, status])
  @@index([nicheId])
  @@map("freelance_campaigns")
}

model ProspectingJob {
  id                   String                @id @default(cuid())
  userId               String                @map("user_id")
  campaignId           String                @map("campaign_id")
  status               ProspectingJobStatus  @default(pending)
  currentStep          ProspectingJobStep    @default(queued) @map("current_step")
  providerName         String                @map("provider_name")
  providerRunId        String?               @map("provider_run_id")
  sourceQuery          String                @map("source_query")
  requestedMaxResults  Int                   @default(50) @map("requested_max_results")
  inspectedCount       Int                   @default(0) @map("inspected_count")
  acceptedCount        Int                   @default(0) @map("accepted_count")
  duplicateCount       Int                   @default(0) @map("duplicate_count")
  rejectedCount        Int                   @default(0) @map("rejected_count")
  failedCount          Int                   @default(0) @map("failed_count")
  providerStatus       String                @default("pending") @map("provider_status")
  providerErrorCode    String?               @map("provider_error_code")
  providerErrorMessage String?               @map("provider_error_message")
  diagnostics          Json                  @default("{}")
  startedAt            DateTime?             @map("started_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  campaign             FreelanceCampaign     @relation(fields: [campaignId], references: [id])
  leads                FreelanceLead[]

  @@index([userId, status])
  @@index([campaignId, status])
  @@map("prospecting_jobs")
}

model FreelanceLead {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  campaignId            String             @map("campaign_id")
  jobId                 String?            @map("job_id")
  nicheId               String?            @map("niche_id")
  businessName          String             @map("business_name")
  category              String?
  country               String
  region                String?
  state                 String?
  city                  String
  address               String?
  phone                 String?
  whatsapp              String?
  email                 String?
  websiteUrl            String?            @map("website_url")
  socialUrl             String?            @map("social_url")
  websiteStatus         WebsiteStatus      @default(uncertain) @map("website_status")
  sourceName            String             @map("source_name")
  sourceUrl             String?            @map("source_url")
  sourceQuery           String             @map("source_query")
  sourceIdentifier      String?            @map("source_identifier")
  sourceEvidence        String             @map("source_evidence")
  googleRating          Decimal?           @map("google_rating") @db.Decimal(3, 2)
  googleReviewCount     Int?               @map("google_review_count")
  leadScore             Int                @default(0) @map("lead_score")
  contentScore          Int?               @map("content_score")
  designScore           Int?               @map("design_score")
  performanceScore      Int?               @map("performance_score")
  seoScore              Int?               @map("seo_score")
  temperature           LeadTemperature    @default(cold)
  commercialStatus      CommercialStatus   @default(new) @map("commercial_status")
  classificationReasons Json               @default("[]") @map("classification_reasons")
  demoUrl               String?            @map("demo_url")
  operatorNotes         String?            @map("operator_notes")
  lastGeneratedPromptId String?            @map("last_generated_prompt_id")
  lastGeneratedMessageId String?           @map("last_generated_message_id")
  capturedAt            DateTime           @default(now()) @map("captured_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  campaign              FreelanceCampaign  @relation(fields: [campaignId], references: [id])
  job                   ProspectingJob?    @relation(fields: [jobId], references: [id])
  niche                 FreelanceNiche?    @relation(fields: [nicheId], references: [id])
  websiteAnalyses       WebsiteAnalysis[]
  latestGenerated       LatestGeneratedText[]
  bulkOutreachItems     BulkOutreachItem[]
  outreachEvents        OutreachEvent[]

  @@index([userId, commercialStatus])
  @@index([campaignId])
  @@index([websiteStatus])
  @@map("freelance_leads")
}

model WebsiteAnalysis {
  id                       String        @id @default(cuid())
  userId                   String        @map("user_id")
  leadId                   String        @map("lead_id")
  requestedUrl             String        @map("requested_url")
  finalUrl                 String?       @map("final_url")
  httpStatus               Int?          @map("http_status")
  reachable                Boolean       @default(false)
  httpsEnabled             Boolean       @default(false) @map("https_enabled")
  redirected               Boolean       @default(false)
  detectedStatus           WebsiteStatus @map("detected_status")
  title                    String?
  metaDescription          String?       @map("meta_description")
  headings                 Json          @default("[]")
  ctaTexts                 Json          @default("[]") @map("cta_texts")
  phoneSignals             Json          @default("[]") @map("phone_signals")
  whatsappSignals          Json          @default("[]") @map("whatsapp_signals")
  emailSignals             Json          @default("[]") @map("email_signals")
  formDetected             Boolean       @default(false) @map("form_detected")
  localServiceTextDetected Boolean       @default(false) @map("local_service_text_detected")
  socialOnlyDetected       Boolean       @default(false) @map("social_only_detected")
  linktreeDetected         Boolean       @default(false) @map("linktree_detected")
  aggregatorDetected       Boolean       @default(false) @map("aggregator_detected")
  brokenReason             String?       @map("broken_reason")
  basicPerformanceEvidence Json          @default("{}") @map("basic_performance_evidence")
  basicSeoEvidence         Json          @default("{}") @map("basic_seo_evidence")
  contentScore             Int?          @map("content_score")
  designScore              Int?          @map("design_score")
  performanceScore         Int?          @map("performance_score")
  seoScore                 Int?          @map("seo_score")
  overallOpportunityScore  Int?          @map("overall_opportunity_score")
  evidencePoints           Json          @default("[]") @map("evidence_points")
  analyzedAt               DateTime      @default(now()) @map("analyzed_at")
  createdAt                DateTime      @default(now()) @map("created_at")
  lead                     FreelanceLead @relation(fields: [leadId], references: [id])

  @@index([userId, leadId])
  @@map("website_analyses")
}

model CommercialTemplate {
  id              String          @id @default(cuid())
  userId          String?         @map("user_id")
  name            String
  stage           TemplateStage
  category        String?
  channel         String          @default("any")
  bodyTemplate    String          @map("body_template")
  variablesSchema Json            @default("{}") @map("variables_schema")
  isDefault       Boolean         @default(false) @map("is_default")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  generatedTexts  LatestGeneratedText[]
  bulkOutreachBatches BulkOutreachBatch[]
  bulkOutreachItems   BulkOutreachItem[]

  @@index([userId, stage, isActive])
  @@map("commercial_templates")
}

model SellerSettings {
  id                 String       @id @default(cuid())
  userId             String       @unique @map("user_id")
  defaultMarketScope MarketScope  @default(BR) @map("default_market_scope")
  sellerName         String?      @map("seller_name")
  sellerTitle        String?      @map("seller_title")
  sellerEmail        String?      @map("seller_email")
  sellerWhatsapp     String?      @map("seller_whatsapp")
  companyWebsite     String?      @map("company_website")
  portfolioUrl       String?      @map("portfolio_url")
  sellerLinkedinUrl  String?      @map("seller_linkedin_url")
  defaultCountry     String?      @map("default_country")
  defaultCurrency    String?      @map("default_currency")
  offerTitle         String?      @map("offer_title")
  offerDescription   String?      @map("offer_description")
  landingPagePrice   Decimal?     @map("landing_page_price") @db.Decimal(10, 2)
  landingPagePriceUsd Decimal?     @map("landing_page_price_usd") @db.Decimal(10, 2)
  advancedPriceRangeBrl String?      @map("advanced_price_range_brl")
  advancedPriceRangeUsd String?      @map("advanced_price_range_usd")
  automationPriceRangeBrl String?    @map("automation_price_range_brl")
  automationPriceRangeUsd String?    @map("automation_price_range_usd")
  installments       Int?
  deliveryTime       String?      @map("delivery_time")
  preferredNicheIds  Json         @default("[]") @map("preferred_niche_ids")
  extraContext       String?      @map("extra_context")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("seller_settings")
}

model LatestGeneratedText {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  leadId       String              @map("lead_id")
  kind         GeneratedTextKind
  variant      String
  templateId   String?             @map("template_id")
  stage        TemplateStage?
  text         String
  inputContext Json                @default("{}") @map("input_context")
  copiedAt     DateTime?           @map("copied_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  lead         FreelanceLead       @relation(fields: [leadId], references: [id])
  template     CommercialTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId, leadId, kind])
  @@unique([leadId, kind, variant, stage])
  @@map("latest_generated_texts")
}

model BulkOutreachBatch {
  id                        String                  @id @default(cuid())
  userId                    String                  @map("user_id")
  channel                   OutreachChannel
  campaignId                String?                 @map("campaign_id")
  templateId                String?                 @map("template_id")
  stage                     TemplateStage           @default(first_contact)
  status                    BulkOutreachBatchStatus @default(draft)
  selectedCount             Int                     @default(0) @map("selected_count")
  eligibleCount             Int                     @default(0) @map("eligible_count")
  missingContactCount       Int                     @default(0) @map("missing_contact_count")
  invalidContactCount       Int                     @default(0) @map("invalid_contact_count")
  duplicateCount            Int                     @default(0) @map("duplicate_count")
  generatedCount            Int                     @default(0) @map("generated_count")
  failedCount               Int                     @default(0) @map("failed_count")
  skippedCount              Int                     @default(0) @map("skipped_count")
  approvedCount             Int                     @default(0) @map("approved_count")
  sentCount                 Int                     @default(0) @map("sent_count")
  failedSendCount           Int                     @default(0) @map("failed_send_count")
  channelLimitSnapshot      Json                    @default("{}") @map("channel_limit_snapshot")
  generationContextSnapshot Json                    @default("{}") @map("generation_context_snapshot")
  diagnostics               Json                    @default("[]")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  generatedAt               DateTime?               @map("generated_at")
  approvedAt                DateTime?               @map("approved_at")
  completedAt               DateTime?               @map("completed_at")
  campaign                  FreelanceCampaign?      @relation(fields: [campaignId], references: [id])
  template                  CommercialTemplate?     @relation(fields: [templateId], references: [id])
  items                     BulkOutreachItem[]
  events                    OutreachEvent[]

  @@index([userId, status])
  @@index([userId, channel, stage])
  @@index([campaignId])
  @@map("bulk_outreach_batches")
}

model BulkOutreachItem {
  id                     String                 @id @default(cuid())
  userId                 String                 @map("user_id")
  batchId                String                 @map("batch_id")
  leadId                 String                 @map("lead_id")
  campaignId             String?                @map("campaign_id")
  channel                OutreachChannel
  status                 BulkOutreachItemStatus @default(queued)
  contactSource          String                 @default("lead_existing") @map("contact_source")
  recipientEmail         String?                @map("recipient_email")
  recipientPhone         String?                @map("recipient_phone")
  recipientWhatsapp      String?                @map("recipient_whatsapp")
  subject                String?
  body                   String?
  message                String?
  templateId             String?                @map("template_id")
  generationInputContext Json                   @default("{}") @map("generation_input_context")
  generationErrorCode    String?                @map("generation_error_code")
  generationErrorMessage String?                @map("generation_error_message")
  validationErrorCode    String?                @map("validation_error_code")
  validationErrorMessage String?                @map("validation_error_message")
  duplicateOfEventId     String?                @map("duplicate_of_event_id")
  skipReason             String?                @map("skip_reason")
  operatorEditedAt       DateTime?              @map("operator_edited_at")
  approvedAt             DateTime?              @map("approved_at")
  sentAt                 DateTime?              @map("sent_at")
  providerName           String?                @map("provider_name")
  providerMessageId      String?                @map("provider_message_id")
  providerStatus         String?                @map("provider_status")
  providerErrorCode      String?                @map("provider_error_code")
  providerErrorMessage   String?                @map("provider_error_message")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  batch                  BulkOutreachBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lead                   FreelanceLead          @relation(fields: [leadId], references: [id])
  campaign               FreelanceCampaign?     @relation(fields: [campaignId], references: [id])
  template               CommercialTemplate?    @relation(fields: [templateId], references: [id])
  duplicateOfEvent       OutreachEvent?         @relation("DuplicateOutreachEvent", fields: [duplicateOfEventId], references: [id])
  events                 OutreachEvent[]

  @@index([userId, batchId])
  @@index([userId, leadId, channel, status])
  @@index([campaignId, channel])
  @@map("bulk_outreach_items")
}

model OutreachChannelSetting {
  id                 String                 @id @default(cuid())
  userId             String                 @map("user_id")
  channel            OutreachChannel
  providerName       String                 @map("provider_name")
  displayName        String?                @map("display_name")
  displayAddress     String?                @map("display_address")
  status             ChannelReadinessStatus @default(disabled)
  enabled            Boolean                @default(false)
  dailyLimit         Int?                   @map("daily_limit")
  remainingToday     Int?                   @map("remaining_today")
  limitResetAt       DateTime?              @map("limit_reset_at")
  requiredEnvVars    Json                   @default("[]") @map("required_env_vars")
  missingEnvVars     Json                   @default("[]") @map("missing_env_vars")
  diagnosticCode     String?                @map("diagnostic_code")
  diagnosticMessage  String?                @map("diagnostic_message")
  lastCheckedAt      DateTime?              @map("last_checked_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@unique([userId, channel])
  @@index([userId, status])
  @@map("outreach_channel_settings")
}

model OutreachEvent {
  id                String              @id @default(cuid())
  userId            String              @map("user_id")
  batchId           String?             @map("batch_id")
  itemId            String?             @map("item_id")
  leadId            String              @map("lead_id")
  campaignId        String?             @map("campaign_id")
  channel           OutreachChannel
  stage             TemplateStage       @default(first_contact)
  eventType         OutreachEventType   @map("event_type")
  providerName      String?             @map("provider_name")
  providerMessageId String?             @map("provider_message_id")
  recipient         String?
  subject           String?
  status            String
  diagnosticCode    String?             @map("diagnostic_code")
  diagnosticMessage String?             @map("diagnostic_message")
  payload           Json                @default("{}")
  occurredAt        DateTime            @default(now()) @map("occurred_at")
  batch             BulkOutreachBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  item              BulkOutreachItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  lead              FreelanceLead       @relation(fields: [leadId], references: [id])
  campaign          FreelanceCampaign?  @relation(fields: [campaignId], references: [id])
  duplicateItems    BulkOutreachItem[]  @relation("DuplicateOutreachEvent")

  @@index([userId, leadId, channel, stage])
  @@index([userId, batchId])
  @@index([campaignId, channel])
  @@index([eventType, occurredAt])
  @@map("outreach_events")
}
