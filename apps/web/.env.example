# Freelance web app local environment.
# Keep secrets server-side only; do not expose provider keys to client components.

DATABASE_URL=postgresql://scrapper:scrapper@localhost:5433/freelance_app
FREELANCE_AUTH_API_BASE_URL=http://localhost:8000
FREELANCE_WEB_APP_BASE_URL=http://localhost:3000
FREELANCE_MAPS_PROVIDER=mock
APIFY_TOKEN=
SERPAPI_API_KEY=
OPENAI_API_KEY=
AI_FREELANCE_MODEL=gpt-4o-mini

# Freelance bulk outreach. Keep provider secrets server-side only.
FREELANCE_EMAIL_PROVIDER=resend
FREELANCE_EMAIL_DAILY_LIMIT=500
FREELANCE_EMAIL_FROM=
RESEND_API_KEY=

FREELANCE_WHATSAPP_PROVIDER=twilio
FREELANCE_WHATSAPP_DAILY_LIMIT=500
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
